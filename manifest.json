{
  "manifest_version": 2,
  "name": "firefox-addon-demo",
  "version": "1.0",

  "description": "A demo of a firefox addon using typescript",

  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },

  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["dist/index.js"]
    }
  ],

  "permissions": ["tabs"],

  "browser_action": {
    "default_icon": "icons/icon-48.png",
    "default_title": "firefox-addon-demo",
    "default_popup": "popup/popup.html"
  }
}
